<UserControl
    x:Class="FluxStudio.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid x:Name="SettingsRoot" Padding="22" RowSpacing="16" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="配置 Flux Studio 的外观、编辑行为和原生运行时。保存后应用立即生效。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Padding="0,8,8,8">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="应用主题" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <TextBlock Text="编辑器" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="字体" VerticalAlignment="Center" />
                        <TextBox x:Name="FontFamilyBox" Grid.Column="1" PlaceholderText="例如 Consolas 或 Cascadia Mono" />
                        <TextBlock Grid.Row="1" Text="字体大小" VerticalAlignment="Center" />
                        <NumberBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="40" SmallChange="1" LargeChange="2" SpinButtonPlacementMode="Inline" />
                        <TextBlock Grid.Row="2" Text="缩进空格数" VerticalAlignment="Center" />
                        <NumberBox x:Name="IndentSizeBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="8" SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Inline" />
                        <CheckBox x:Name="AutoIndentCheck" Grid.Row="3" Grid.ColumnSpan="2" Content="按 Enter 自动缩进代码块" />
                        <CheckBox x:Name="AutoEndCheck" Grid.Row="4" Grid.ColumnSpan="2" Content="输入代码块头后自动插入 end" />
                        <CheckBox x:Name="CompletionCheck" Grid.Row="5" Grid.ColumnSpan="2" Content="启用自动补全列表" />
                    </Grid>
                    <TextBlock Text="提示：按住 Ctrl 并滚动鼠标滚轮可调整字号"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <TextBlock Text="原生 Flux 解释器" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Flux.Core 是独立的跨平台解释器,基于C++ 17"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="解释器可执行文件（高级设置）" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InterpreterPathBox" PlaceholderText="Runtime/bin/flux.exe（包内路径）或完整路径" />
                        <Button Grid.Column="1" Content="浏览…" Click="BrowseInterpreter_Click" />
                    </Grid>
                    <TextBlock Text="工作目录（可选）" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirectoryBox" PlaceholderText="留空则使用当前项目或源文件目录" />
                        <Button Grid.Column="1" Content="选择文件夹…" Click="BrowseWorkingDirectory_Click" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
